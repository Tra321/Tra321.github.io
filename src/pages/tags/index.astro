---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
const tags = Object.entries(Object.groupBy(posts.flatMap((post) => post.data.tags), (tag) => tag))
  .map(([name, values]) => ({ name, count: values?.length ?? 0 }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout title="标签" description="按标签浏览文章">
  <header class="page-head shell"><span class="eyebrow">TOPICS</span><h1>文章标签</h1></header>
  <section class="section shell tag-cloud">
    {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag.name)}/`}><span>#{tag.name}</span><b>{tag.count}</b></a>)}
  </section>
</BaseLayout>
