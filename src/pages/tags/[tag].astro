---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`Atra 关于 ${tag} 的文章`}>
  <header class="page-head shell"><span class="eyebrow">TOPIC</span><h1>#{tag}</h1><p>共 {posts.length} 篇文章</p></header>
  <section class="section shell post-grid">{posts.map((post) => <PostCard post={post} />)}</section>
</BaseLayout>
