---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.map((category) => ({ params: { category }, props: { category, posts: posts.filter((post) => post.data.category === category) } }));
}
const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category}`} description={`Atra 的 ${category} 分类文章`}>
  <header class="page-head shell"><span class="eyebrow">CATEGORY</span><h1>{category}</h1><p>共 {posts.length} 篇文章</p></header>
  <section class="section shell post-grid">{posts.map((post) => <PostCard post={post} />)}</section>
</BaseLayout>
